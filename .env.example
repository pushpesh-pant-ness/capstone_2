# Copy this file to `.env` in this same folder, then fill in real values.
# `.env` is git-ignored (see repo root .gitignore) — never commit real secrets.
# Loaded directly by the local process / docker-compose (no k8s Secret in the MVP).

# --- Postgres ---
DATABASE_URL=postgresql://incident_agent:incident_agent_dev_password@localhost:5432/incident_agent

# --- AWS Bedrock (required for LLM-based severity/RCA/planning; NFR-6: falls
# back to agent/heuristics.py if unset or the call fails) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# SRS §10.B open question: exact approved model ID. Claude 3.5 Sonnet is retired
# on this account; amazon.nova-pro-v1:0 is confirmed available.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# --- Observability backends the Investigate/Validation nodes query ---
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090

# --- Kubernetes remediation target (FR-18: never inferred) ---
APP_NAMESPACE=default
KUBECONFIG_CONTEXT=kind-incident-agent

# --- Executor behavior ---
DRY_RUN=false
VALIDATION_WINDOW_SECONDS=180
VALIDATION_POLL_SECONDS=15
